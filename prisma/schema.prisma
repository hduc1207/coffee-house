generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Bảng Sản phẩm
model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  price       Int
  image       String
  description String
  origin      String
  roast       String
  category    String   @default("Cà phê")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Bảng lưu thông tin Đơn hàng chung
model Order {
  id             String      @id @default(uuid())
  customerName   String
  phone          String
  address        String?
  notes          String?
  deliveryMethod String
  paymentMethod  String
  totalAmount    Int
  status         String      @default("PENDING")
  createdAt      DateTime    @default(now())
  items          OrderItem[]
}

// Bảng lưu chi tiết từng món trong Đơn hàng
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Int
  quantity  Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}