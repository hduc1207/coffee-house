generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

model Voucher {
  id           String       @id @default(cuid())
  code         String       @unique
  type         DiscountType
  value        Int
  maxDiscount  Int?
  minOrder     Int?
  usageLimit   Int?
  usedCount    Int          @default(0)
  isActive     Boolean      @default(true)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders       Order[]

  @@index([isActive, expiresAt])
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  price       Int
  image       String
  description String
  origin      String
  roast       String
  category    String   @default("Cà phê")
  stock       Int      @default(100)
  isAvailable Boolean  @default(true)

  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isAvailable])
}

model Order {
  id             String      @id @default(uuid())
  orderCode      Int         @unique @default(autoincrement())
  customerName   String
  phone          String
  address        String?
  notes          String?
  deliveryMethod String
  paymentMethod  String
  paymentLinkId  String?
  payosQrCode    String?
  payosAccountNumber String?
  payosAccountName   String?
  payosBin       String?
  payosCheckoutUrl String?
  totalAmount    Int
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  items          OrderItem[]
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  voucherId      String?
  voucher        Voucher?    @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  discountAmount Int         @default(0)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([voucherId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Int
  quantity  Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  street    String
  isDefault Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Store {
  id        String   @id @default(cuid())
  city      String
  name      String
  address   String
  hours     String
  phone     String
  image     String
  desc      String

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}